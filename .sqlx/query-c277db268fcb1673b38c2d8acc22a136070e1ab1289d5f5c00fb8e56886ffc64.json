  "query": "SELECT s.id, s.can_write, s.grantee_user_id, u.email AS \"email?\", s.grantee_group_id, g.name AS \"group_name?\"\n               FROM dav_shares s LEFT JOIN users u ON u.id = s.grantee_user_id LEFT JOIN groups g ON g.id = s.grantee_group_id\n               WHERE s.collection_id = $1 ORDER BY lower(COALESCE(u.email, g.name))",
