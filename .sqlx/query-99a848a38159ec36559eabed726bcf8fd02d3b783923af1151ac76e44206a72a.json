  "db_name": "PostgreSQL",
  "query": "INSERT INTO aliases (domain_id, address, destination)\n               SELECT d.id, $2::text, $3::text\n               FROM domains d\n               WHERE d.id = $1 AND split_part($2::text, '@', 2) = d.name\n               RETURNING id, domain_id, address, destination, enabled, created_at",
