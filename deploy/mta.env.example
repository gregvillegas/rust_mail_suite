# Settings for scripts/setup-mta.sh. Copy to /etc/rustmail/mta.env (mode 0600) and edit.
# Every value is substituted into the templates under deploy/postfix and deploy/dovecot.

# ─── Identity ───────────────────────────────────────────────────────────────
MTA_HOSTNAME=mail.example.com
# Networks allowed to relay without authenticating (space separated).
MTA_MYNETWORKS="127.0.0.0/8 [::1]/128"
MTA_INET_PROTOCOLS=all
# Smarthost for outbound mail, e.g. [smtp.provider.net]:587. Empty = deliver directly.
MTA_RELAYHOST=
MTA_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILLOG_FILE=/var/log/mail.log
DOVECOT_LOG_PATH=/var/log/dovecot.log
# Extra text appended to Dovecot's mail_location (dev uses it to move indexes).
DOVECOT_MAIL_LOCATION_EXTRA=

# ─── TLS ────────────────────────────────────────────────────────────────────
# Debian's self-signed snakeoil pair. Replace with real certificates (Phase 10).
TLS_CERT=/etc/ssl/certs/ssl-cert-snakeoil.pem
TLS_KEY=/etc/ssl/private/ssl-cert-snakeoil.key

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rustmail
# Used once by setup-mta.sh to create the two roles below. Needs CREATEROLE.
DB_ADMIN_URL=postgres://rustmail:CHANGE_ME@127.0.0.1:5432/rustmail
POSTFIX_DB_USER=rustmail_postfix
POSTFIX_DB_PASSWORD=CHANGE_ME
DOVECOT_DB_USER=rustmail_dovecot
DOVECOT_DB_PASSWORD=CHANGE_ME
AMAVIS_DB_USER=rustmail_amavis
AMAVIS_DB_PASSWORD=CHANGE_ME

# ─── Virtual mail storage ───────────────────────────────────────────────────
VMAIL_USER=vmail
VMAIL_UID=5000
VMAIL_GID=5000
VMAIL_BASE=/var/mail/vhosts

# ─── Virus and spam filtering (Phase 5) ─────────────────────────────────────
# Postfix content filter. Empty = no filtering at all.
MTA_CONTENT_FILTER=smtp-amavis:[127.0.0.1]:10024
# Where the "re-entry" SMTP listener (port 10025) binds, and which clients may use it.
# Amavis uses it, and so does the quarantine "release" action in the web UI.
# Keep it on loopback unless RustMail runs on another host.
MTA_REINJECT_BIND=127.0.0.1
# Comma separated (no spaces): it is placed on a master.cf line.
MTA_REINJECT_CLIENTS=127.0.0.0/8
# Amavis log. With AMAVIS_DO_SYSLOG=1 it goes to syslog (and so into /var/log/mail.log).
AMAVIS_DO_SYSLOG=1
AMAVIS_LOG_FILE=/var/log/amavis.log
AMAVIS_MAX_SERVERS=2
# 1 = skip the virus scan (for machines too small to run ClamAV).
AMAVIS_BYPASS_VIRUS_CHECKS=0
CLAMD_SOCKET=/var/run/clamav/clamd.ctl
# Quarantined messages; written by Amavis, managed by RustMail (group: the vmail group).
QUARANTINE_DIR=/var/lib/rustmail/quarantine
# SpamAssassin's learned (Bayesian) data, shared by Amavis and the mail user.
BAYES_DIR=/var/lib/rustmail/bayes
# 1 = no DNS blocklist lookups.
SPAMASSASSIN_SKIP_NETWORK=0

# ─── Webmail access (Phase 6) ───────────────────────────────────────────────
# The web server logs in to Dovecot (IMAP) and Postfix (submission) as
# "<user>*<MAIL_MASTER_USER>" with this password, so it never needs users'
# passwords. Use a long random value (`openssl rand -hex 24`) and put the same
# MAIL_MASTER_USER / MAIL_MASTER_PASSWORD in the web server's environment.
# No whitespace, ':', '*', quotes, braces or backslashes.
MAIL_MASTER_USER=webmail
MAIL_MASTER_PASSWORD=CHANGE_ME
# Networks the master login is accepted from (comma separated, no spaces):
# the machine the web server runs on.
MAIL_MASTER_ALLOW_NETS=127.0.0.1
