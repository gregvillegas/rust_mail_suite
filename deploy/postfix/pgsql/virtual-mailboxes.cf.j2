# Managed by RustMail Suite (rendered from deploy/postfix/pgsql/virtual-mailboxes.cf.j2).
# Local edits are overwritten the next time scripts/setup-mta.sh runs.
#
# virtual_mailbox_maps: which recipient addresses exist. Postfix rejects mail to
# anything else during the SMTP conversation (550 5.1.1) instead of accepting it
# and bouncing later. Only active users in active domains with an active mailbox.
hosts = {{ db_host }}:{{ db_port }}
dbname = {{ db_name }}
user = {{ postfix_db_user }}
password = {{ postfix_db_password }}
query = SELECT 1 FROM users u JOIN domains d ON d.id = u.domain_id JOIN mailboxes m ON m.user_id = u.id WHERE u.email = lower('%s') AND u.status = 'active' AND d.status = 'active' AND m.status = 'active'
