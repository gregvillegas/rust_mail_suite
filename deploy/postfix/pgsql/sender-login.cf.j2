# Managed by RustMail Suite (rendered from deploy/postfix/pgsql/sender-login.cf.j2).
# Local edits are overwritten the next time scripts/setup-mta.sh runs.
#
# smtpd_sender_login_maps: which login names may use a sender address. The
# submission service uses it to refuse an authenticated user who tries to send
# as somebody else: a user may send as their own address and as any alias that
# points to it.
hosts = {{ db_host }}:{{ db_port }}
dbname = {{ db_name }}
user = {{ postfix_db_user }}
password = {{ postfix_db_password }}
query = SELECT u.email FROM users u WHERE u.email = lower('%s') AND u.status = 'active' UNION SELECT a.destination FROM aliases a WHERE a.address = lower('%s') AND a.enabled
