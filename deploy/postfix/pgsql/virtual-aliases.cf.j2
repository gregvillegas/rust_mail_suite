# Managed by RustMail Suite (rendered from deploy/postfix/pgsql/virtual-aliases.cf.j2).
# Local edits are overwritten the next time scripts/setup-mta.sh runs.
#
# virtual_alias_maps (1 of 2): alias address -> destination address(es). An alias
# with several destinations is several rows; Postfix returns them all.
hosts = {{ db_host }}:{{ db_port }}
dbname = {{ db_name }}
user = {{ postfix_db_user }}
password = {{ postfix_db_password }}
query = SELECT a.destination FROM aliases a JOIN domains d ON d.id = a.domain_id WHERE a.address = lower('%s') AND a.enabled AND d.status = 'active'
