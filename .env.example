# RustMail Suite — environment configuration template.
# Copy to `.env` and adjust. Never commit the real `.env` (it is gitignored).

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=rustmail
POSTGRES_PASSWORD=rustmail
POSTGRES_DB=rustmail
# Host port for the dev container. 5433 (not 5432) so it does not collide with
# a Postgres already installed on the developer machine.
POSTGRES_PORT=5433
# Connection string used by sqlx / the Rust services.
DATABASE_URL=postgres://rustmail:rustmail@localhost:5433/rustmail
# Compile sqlx queries from the committed .sqlx/ cache instead of a live
# database, so `cargo build` works without Postgres running. Set to false (or
# run `make prepare`) after changing a query or migration.
SQLX_OFFLINE=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Mailpit (dev SMTP sink) ─────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Outbound submission target for dev (points at Mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Web / Admin servers ─────────────────────────────────────────────────────
WEB_BIND_ADDR=127.0.0.1:8080
ADMIN_BIND_ADDR=127.0.0.1:8081

# ─── Logging ─────────────────────────────────────────────────────────────────
# tracing-subscriber EnvFilter directive.
RUST_LOG=info

# ─── Authentication (Phase 2) ────────────────────────────────────────────────
# REQUIRED by rustmail-web. At least 32 bytes. Generate one with:
#     openssl rand -hex 32
# This placeholder is rejected at startup on purpose, so a forgotten secret
# fails loudly instead of running with a well-known key.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Access token (JWT) lifetime, and refresh token / session lifetime, in seconds.
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=1209600
# Lock an account for AUTH_LOCKOUT_SECS after this many consecutive wrong passwords.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECS=900
# After a refresh token is rotated, replaying it within this many seconds is
# treated as a harmless race; later replays are treated as theft and revoke
# every session of the user. 0 disables the grace window.
AUTH_REFRESH_REUSE_GRACE_SECS=10

# ─── Cookies, proxy and rate limits (Phase 2) ────────────────────────────────
# Mark cookies Secure (HTTPS only). Keep true in production. False only so that
# local development over plain http://localhost works in every browser.
COOKIE_SECURE=false
# Take the client IP from X-Forwarded-For / X-Real-IP. Enable ONLY behind exactly
# one trusted reverse proxy that sets the header; otherwise clients can spoof
# their IP and evade rate limiting.
TRUST_PROXY_HEADERS=false
# Token buckets per client IP: BURST requests at once, one more every PERIOD_SECS.
LOGIN_RATE_BURST=5
LOGIN_RATE_PERIOD_SECS=12
REFRESH_RATE_BURST=20
REFRESH_RATE_PERIOD_SECS=3

# ─── Web UI (Phase 3) ────────────────────────────────────────────────────────
# Where Bootstrap, htmx and Alpine are loaded from:
#   cdn   - jsDelivr with Subresource Integrity, falling back to the bundled copy
#   local - always the bundled copy (air-gapped or privacy-sensitive installs; also
#           removes the CDN origin from the Content-Security-Policy)
ASSET_SOURCE=cdn
# Directory served under /static. Defaults to the crate's own static/ directory,
# which only exists in a source checkout: set it when deploying the binary.
# STATIC_DIR=/opt/rustmail/static

# --- Mailbox storage (Phase 4) ---
# Where Maildirs live. The directory must exist; RustMail creates <domain>/<user>/Maildir inside it.
# Development (make mta-up) uses ./var/vhosts. Production: /var/mail/vhosts.
VMAIL_BASE=./var/vhosts
# Mode for directories RustMail creates. 0700 when RustMail runs as the vmail user;
# 0770 when it runs as another user in the vmail group (base dir is vmail:vmail 2770).
VMAIL_DIR_MODE=0700

# --- Calendar and contacts (Phase 9) ---
# CalDAV and CardDAV are served by the web server itself under /dav (and /.well-known/caldav
# and /.well-known/carddav redirect there). Apps sign in with an app password made on
# /settings/apps, never the account password. HTTP Basic sends that secret with every request,
# so serve this over HTTPS anywhere but a developer's machine (COOKIE_SECURE=true says so).
# No settings are needed.

# --- Filters and autoresponder (Phase 8) ---
# Where users' Sieve scripts are installed (ManageSieve, port 4190 on the Dovecot host).
# Defaults: the IMAP host and port 4190. The web server logs in as <user>*<master>, exactly
# like webmail, and only after STARTTLS succeeded. Without MAIL_MASTER_PASSWORD (webmail off)
# filters can still be edited, but are not installed.
# SIEVE_HOST=mail.example.com
# SIEVE_PORT=4190

# --- Admin console (Phase 7) ---
# The web server creates and removes Maildirs when administrators add or delete users,
# so it needs VMAIL_BASE (above) with write access. Without it the console cannot
# create accounts.
# Health page probes. Anything unset or not reachable from this host is shown as
# "Not checked" (not "Down"). REDIS_URL (above) is probed too.
# CLAMD_SOCKET=/var/run/clamav/clamd.ctl
# HEALTH_AMAVIS_ADDR=127.0.0.1:10024

# --- Mail filtering pipeline (Phase 5) ---
# Where Amavis keeps quarantined messages. Setting it enables the quarantine pages
# in the web UI and the `rustmail-cli quarantine` commands. Development: ./var/quarantine.
QUARANTINE_DIR=./var/quarantine
# Postfix's re-entry SMTP port, used when a quarantined message is released.
# The dev MTA container publishes it on loopback.
REINJECT_ADDR=127.0.0.1:10025
# Log files `rustmail-cli pipeline` reads (comma separated) and their time zone.
# Development: the container writes UTC logs into ./var/log.
PIPELINE_LOG_FILES=./var/log/amavis.log,./var/log/postfix.log
PIPELINE_LOG_TIMEZONE=utc

# --- Webmail (Phase 6) ---
# Setting MAIL_MASTER_PASSWORD turns webmail on. The web server logs in to Dovecot and
# Postfix as "<user>*<MAIL_MASTER_USER>" with it (Dovecot's master-user feature), so it
# never holds users' passwords. It must match MAIL_MASTER_PASSWORD in the mail server's
# settings (deploy/mta.env, rendered by scripts/setup-mta.sh).
# Development values for `make mta-up` (published ports, self-signed certificates):
MAIL_MASTER_USER=webmail
MAIL_MASTER_PASSWORD=dev-webmail-master-password
IMAP_HOST=127.0.0.1
IMAP_PORT=1993
SMTP_HOST=127.0.0.1
SMTP_PORT=5587
# Development only: accept the container's self-signed certificate. In production leave
# this unset and, for a private CA, set MAIL_TLS_CA_FILE; if you connect by IP address
# or an internal name, set MAIL_TLS_SERVER_NAME to the name on the certificate.
MAIL_TLS_INSECURE=1
