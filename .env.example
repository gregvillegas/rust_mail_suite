# RustMail Suite — example environment configuration.
# Copy to `.env` and adjust. Never commit the real `.env`.

# ─── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=rustmail
POSTGRES_PASSWORD=rustmail
POSTGRES_DB=rustmail
POSTGRES_PORT=5432
# Connection string used by sqlx / the Rust services and `make migrate`.
DATABASE_URL=postgres://rustmail:rustmail@localhost:5432/rustmail

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Dev SMTP sink (Mailpit) ───────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Outbound mail during development is sent here.
SMTP_URL=smtp://localhost:1025

# ─── Web / Admin services ──────────────────────────────────────────────────
WEB_BIND_ADDR=127.0.0.1:8080
ADMIN_BIND_ADDR=127.0.0.1:8081

# ─── Logging ───────────────────────────────────────────────────────────────
# tracing-subscriber EnvFilter directive.
RUST_LOG=info

# ─── Secrets (Phase 2+) ────────────────────────────────────────────────────
# Signing key for JWT access/refresh tokens. Generate a strong random value
# for real deployments, e.g.:  openssl rand -base64 48
JWT_SIGNING_KEY=change-me-in-production
