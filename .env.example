# RustMail Suite — environment configuration template.
# Copy to `.env` and adjust. Never commit the real `.env` (it is gitignored).

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=rustmail
POSTGRES_PASSWORD=rustmail
POSTGRES_DB=rustmail
POSTGRES_PORT=5432
# Connection string used by sqlx / the Rust services.
DATABASE_URL=postgres://rustmail:rustmail@localhost:5432/rustmail

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Mailpit (dev SMTP sink) ─────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Outbound submission target for dev (points at Mailpit).
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Web / Admin servers ─────────────────────────────────────────────────────
WEB_BIND_ADDR=127.0.0.1:8080
ADMIN_BIND_ADDR=127.0.0.1:8081

# ─── Logging ─────────────────────────────────────────────────────────────────
# tracing-subscriber EnvFilter directive.
RUST_LOG=info

# ─── Secrets (Phase 2+) ──────────────────────────────────────────────────────
# Generate strong random values before enabling auth. Placeholders only.
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=1209600
